# Settings for the server. Put the ones you need in server/.env (that file is never committed).

# OneMap login for the meeting-place search (see config/places.js).
# Leave both empty: the search works without an account. Only fill them in if the server log
# says "OneMap refused the search". A free account is made at onemap.gov.sg.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Only needed on the hosting site (Vercel). On your own computer leave both out.
# FRONTEND_URL: the address of the front end, no slash at the end, e.g. https://kongsi.vercel.app
#   (several addresses: separate them with commas).
# FIREBASE_KEY_JSON: the whole text of firebaseKey.json pasted as one value.
# FRONTEND_URL=
# FIREBASE_KEY_JSON=
